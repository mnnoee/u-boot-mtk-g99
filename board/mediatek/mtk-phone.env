bootdelay=0
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Fastboot
fastboot=fastboot -l $fastboot_addr_r usb 0

# USB Serial Console (CDC ACM) — поднимает ACM и показывает bootmenu
serial_gadget=setenv stdin serial,usbacm; setenv stdout serial,usbacm; setenv stderr serial,usbacm; usb start; echo "USB serial console active"; bootmenu -1

# Set up a block map pointing to our subpartition
setup_rootdev=scsi device 2; setenv rootdev scsi 2
setup_blkmap=part start ${rootdev} userdata userdata_start; part size ${rootdev} userdata userdata_size; blkmap create root; blkmap map root 0 0x${userdata_size} linear ${rootdev} 0x${userdata_start}
preboot=setenv stdin serial,button-kbd; setenv stdout serial,vidconsole; setenv stderr serial,vidconsole; scsi reset; scsi scan
#preboot=usb start; setenv stdin serial,usbacm,button-kbd; setenv stdout serial,usbacm,vidconsole; setenv stderr serial,usbacm,vidconsole

# Go straight to bootmenu — but dump DRAM first: the boot AFTER a kernel
# attempt must capture the kernel's log_buf before anything else touches it.
bootcmd=run a_dump; run menucmd

# Menu setup
menucmd=setenv bootcmd run menucmd; bootmenu -1

bootmenu_0=Fastboot USB=run fastboot
bootmenu_1=Boot Android + dump=run android
bootmenu_2=Enable serial console gadget=run serial_gadget
bootmenu_3=Enable USB mass storage=echo "Press any key to exit UMS mode"; ums 0 scsi 2
bootmenu_4=Drop to shell=setenv bootretry -1
bootmenu_5=Reset device=reset
bootmenu_6=Dump clocks=clk dump; pause
bootmenu_7=Dump environment=printenv; pause
bootmenu_8=Board info=bdinfo; pause

# Android kernel boot chain, addresses verified on the device.
# SCSI blocks on this device are 4 KiB, so the partition LBAs below are
# 4 KiB too. vendor_boot_a carries the vendor ramdisk and the base DTB,
# which is the same tree the stock LK hands to the kernel.
a_load=scsi device 2; scsi read 0x44000000 0x30a00 0x19c0; scsi read 0x40000000 0x2ca00 0x4000
a_prep=abootimg addr 0x40000000 0x44000000; setenv kernel_addr_r 0x60000000; setenv ramdisk_addr_r 0x64000000; fdt addr 0x459b1040; mw.l 0x459b2b2c 0x00000002; mw.l 0x459b2b30 0x00000000
a_args=console=tty0 console=ttyMT0,921600n1 earlycon=uart8250,mmio32,0x11002000,921600n1 loglevel=8 ignore_loglevel initcall_debug=1 init=/nonexistent panic=10
# Dump the kernel's memory image (44.5 MiB at 0x60000000 per kernel_addr_r,
# image_size 0x02A60000 -> .bss/log_buf inside) as 48 MiB into expdb.
a_dump=scsi write 0x60000000 0x508 0x3000
android=run a_load; run a_prep; setenv bootargs $a_args; bootm

# Allow holding volume down to enter menu
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
