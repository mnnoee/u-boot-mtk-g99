bootdelay=0
bootretry=-1
stdin=serial,button-kbd
stdout=serial
stderr=serial

# Fastboot
# g_dnl serves one gadget function at a time: release the ACM console
# before handing the UDC to fastboot/UMS and take it back afterwards.
usbconoff=setenv stdin serial; setenv stdout serial; setenv stderr serial; usbcon off
usbconon=usbcon on; setenv stdin serial,usbacm,button-kbd; setenv stdout serial,usbacm; setenv stderr serial,usbacm
# fastboot_addr_r is not defined on this board: the download buffer comes
# from CONFIG_FASTBOOT_BUF_ADDR.
fastboot=run usbconoff; fastboot usb 0; run usbconon
umsrun=run usbconoff; ums 0 scsi 2; run usbconon

# USB CDC ACM console, brought up automatically at boot.
# UART (physical) stays in the console list as the fallback.
serial_gadget=usb start; setenv stdin serial,usbacm,button-kbd; setenv stdout serial,usbacm; setenv stderr serial,usbacm; echo "USB CDC ACM console active (UART + ACM)"

# Partition helpers
setup_rootdev=scsi device 2; setenv rootdev scsi 2

# Minimal Linux from ext4 on /tranfs (kernel partition sdc62 -> scsi 2:3e, hex)
# Kernel/UART output goes to the physical UART0 (0x11002000), ACM is not used by the kernel.
# Raw initrd needs addr:hexsize (CONFIG_SUPPORT_RAW_INITRD); clk_ignore_unused and
# pd_ignore_unused are required, otherwise mainline hangs in clk_disable_unused.
linux=scsi device 2; setenv kernel_addr_r 0x40000000; setenv fdt_addr_r 0x60000000; setenv ramdisk_addr_r 0x61000000; setenv ramdisk_size 0x3f14b; ext4load scsi 2:3e ${kernel_addr_r} Image && ext4load scsi 2:3e ${fdt_addr_r} x676b.dtb && ext4load scsi 2:3e ${ramdisk_addr_r} initramfs.cpio.gz && setenv bootargs "console=tty0 console=ttyS0,921600n1 earlycon=uart8250,mmio32,0x11002000 8250.nr_uarts=4 clk_ignore_unused pd_ignore_unused loglevel=7 ignore_loglevel panic=10" && booti ${kernel_addr_r} ${ramdisk_addr_r}:${ramdisk_size} ${fdt_addr_r}

# No menu: boot straight into ACM console and leave the user at the prompt.
bootcmd=run serial_gadget

# Bring the ACM console up before touching storage: a hang in the UFS
# probe used to leave the board without any console at all.  "scsi reset"
# is redundant: in this tree it calls the same scsi_scan(true) as "scan".
preboot=run serial_gadget; scsi scan
